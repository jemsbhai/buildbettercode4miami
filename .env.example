# Node.js 22+ required. Copy to .env.local for local development.
# Never commit credentials. Demo mode needs no key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Public service only. Keep unset for the local hackathon demo.
# Configure these as server-side Vercel environment variables for the public project.
# Apply migrations using an admin connection; runtime DATABASE_URL uses a restricted role.
TIDEPATH_PUBLIC_SERVICE=
TIDEPATH_PUBLIC_ORIGIN=
DATABASE_URL=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
GOOGLE_ADDON_CLIENT_ID=
TIDEPATH_SESSION_SECRET=
TIDEPATH_USAGE_SECRET=
CRON_SECRET=
